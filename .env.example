# Copy to .env.production on the server (never commit real values). Secrets are typed in at a hidden prompt.

# Public address of the site, used for links in the sitemap and page metadata.
SITE_URL=https://www.example.com

# Where content, uploaded photos, enquiries and admin users live (outside the code folder, backed up).
DATA_DIR=/var/lib/oor-website

# The CRM's website-lead endpoint and the shared secret (same value as WEBSITE_LEADS_SECRET in the CRM).
CRM_LEADS_URL=https://crm.example.com/api/integrations/website/leads
CRM_LEADS_SECRET=

# The WhatsApp number the site's buttons open (digits with country code). Read at build time, so
# rebuild after changing it. It must be the number the company's WhatsApp app answers on.
NEXT_PUBLIC_WHATSAPP_NUMBER=919111832003

# How often unsent enquiries are retried, in seconds (minimum 15). LEADS_SENDER=off stops the retry timer.
LEADS_RETRY_SECONDS=60

# Optional: signs admin sessions. If empty, a random key is created in DATA_DIR/session.key.
SESSION_SECRET=

# Optional: force the admin cookie's Secure flag (defaults to on in production / behind https).
# ADMIN_COOKIE_SECURE=true
